  "vars": [
    {
      "name": "name",
      "prompt": "Harness name (kebab-case)",
      "validate": "^[a-z0-9-]+$"
    },
    {
      "name": "description",
      "prompt": "One-line description",
      "default": "Plan, implement, review, and test code changes"
    },
    {
      "name": "host",
      "prompt": "Host adapter",
      "default": "claude-code",
      "choices": [
        "claude-code",
        "codex",
        "pi-dev",
        "hermes"
      ]
